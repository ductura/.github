{
  "name": "@ductura/eslint-config",
  "version": "0.1.0",
  "description": "ESLint preset za Ductura repozitorije: pravila koda i granice modularnog monolita kao opcija",
  "license": "UNLICENSED",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ductura/.github.git",
    "directory": "packages/eslint-config"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "rules/*.js"
  ],
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    }
  },
  "dependencies": {
    "typescript-eslint": "8.72.2"
  },
  "peerDependencies": {
    "eslint": "^10.15.0",
    "typescript": "^5.9.3"
  }
}
